	set branchLabels.fontSize=14;
	set branchLabels.fontStyle=0;
	set branchLabels.isShown=true;
	set branchLabels.significantDigits=4;
	set colour.order.sample source="Sample Source:White,human,iberian,swine,vaccine,variant";
